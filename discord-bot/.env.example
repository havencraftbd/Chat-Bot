# Never commit real values to the repo.
# Copy this file to `.env` and fill in the values.
DISCORD_TOKEN=
GROQ_API_KEY=
# Model chain is fixed in bot.js: 120b → 20b → qwen (switch only on 429, invisible in chat).
# Staff role ID of the test server (Server Settings → Roles → right-click role → Copy ID;
# Discord Developer Mode must be on). This role gets mentioned on fallback.
# If left empty, there will be no mention on fallback, only the graceful message.
STAFF_ROLE_ID=
