# আসল value কখনো repo-তে commit করো না।
# এই file-এর copy বানিয়ে `.env` নামে রাখো, তারপর value বসাও।
DISCORD_TOKEN=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Test server-এর staff role-এর ID (Server Settings → Roles → role-এ right-click → Copy ID;
# Discord-এ Developer Mode on থাকতে হবে)। এই role-কেই fallback-এ mention করা হবে।
# খালি থাকলে fallback-এ mention হবে না, শুধু graceful message যাবে।
STAFF_ROLE_ID=
